# ── Binary data files (no useful text for indexing) ──
backend/ingestion/data/docs/*.pdf
backend/ingestion/data/mediassist.db
*.zip

# ── Downloaded model weights (large binaries) ────────
models/
.cache/
*.onnx
*.bin
*.safetensors

# ── Python bytecode ──────────────────────────────────
__pycache__/
*.pyc

# ── Environment and secrets ──────────────────────────
.env
.venv/
venv/

# ── Eval output artifacts (generated, not source) ────
backend/evals/results/

# ── Qdrant Docker volume ─────────────────────────────
qdrant_data/
qdrant_snapshots/

# ── IDE and OS noise ─────────────────────────────────
.idea/
.vscode/
.DS_Store
Thumbs.db

# ── Test / lint caches ───────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# ── Build artifacts ──────────────────────────────────
dist/
build/
*.egg-info/
