FROM python:3.11-slim

WORKDIR /app

# Frontend only needs streamlit + requests — keep the image lean
RUN pip install --no-cache-dir streamlit>=1.36.0 requests>=2.32.0

# Copy frontend code and Streamlit config (port 8700 defined here)
COPY frontend/ frontend/
COPY .streamlit/ .streamlit/

EXPOSE 8700

CMD ["streamlit", "run", "frontend/app.py"]
