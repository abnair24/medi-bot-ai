# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.

# --- HuggingFace Hub (embedding + reranker model downloads) ---
# Get a free read token at huggingface.co → Settings → Access Tokens
# Without this, downloads are rate-limited and unauthenticated (warning on startup).
HF_TOKEN=hf_your_token_here

# --- LLM (Groq) ---
GROQ_API_KEY=your_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Vector store (Qdrant) ---
# Host access uses localhost:6000 (Qdrant is published on host port 6000 to avoid
# colliding with another project's Qdrant). docker-compose overrides these for the
# backend container to qdrant:6333 (the internal port).
QDRANT_HOST=localhost
QDRANT_PORT=6000
COLLECTION_NAME=medibot

# --- Embedding models ---
DENSE_MODEL_NAME=BAAI/bge-small-en-v1.5
SPARSE_MODEL_NAME=Qdrant/bm25
DENSE_VECTOR_SIZE=384

# --- Chunking ---
CHUNK_TOKEN_LIMIT=384
CHUNK_OVERLAP_TOKENS=64
EMBEDDING_BATCH_SIZE=32

# --- Reranker ---
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_K=10
RERANKER_FINAL_K=3

# --- Retrieval ---
RETRIEVAL_TOP_K=10

# --- SQL RAG ---
SQLITE_PATH=backend/ingestion/data/mediassist.db

# --- LangGraph checkpointer ---
CHECKPOINT_DB_PATH=backend/ingestion/data/checkpoints.db

# --- Auth ---
JWT_SECRET=change-this-in-production
JWT_EXPIRY_HOURS=24

# --- Logging ---
LOG_LEVEL=INFO
